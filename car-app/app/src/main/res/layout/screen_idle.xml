<?xml version="1.0" encoding="utf-8"?>
<!-- ② 펫케어 대기: 보호자가 없는 동안 떠 있는 기본 화면. 차 밖에서도 읽히게 크게 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/part_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="660dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="607dp"
                android:layout_height="581dp">

                <View
                    android:layout_width="528dp"
                    android:layout_height="528dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_halo_calm" />

                <ImageView
                    android:id="@+id/bust"
                    android:layout_width="475dp"
                    android:layout_height="548dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="26dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink"
                android:textSize="55sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pill_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="34dp"
                android:paddingVertical="16dp">

                <View
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/dot_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:text="차분해요"
                    android:textColor="@color/primary"
                    android:textSize="34sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="11dp"
            android:paddingBottom="40dp"
            android:paddingEnd="84dp">

            <!-- 위쪽 한 줄 알림: 진정이 끝났을 때, 보호자가 온도·환기를 바꿨을 때 -->
            <LinearLayout
                android:id="@+id/notice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="15dp"
                android:paddingStart="21dp"
                android:paddingEnd="26dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    android:tint="@color/primary" />

                <TextView
                    android:id="@+id/noticeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:textColor="@color/ink2"
                    android:textSize="25sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="반려견이 안전하게\n보호되고 있어요"
                android:textColor="@color/ink"
                android:textSize="87sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="에어컨을 켜 두었고, 보호자가 휴대폰으로 지켜보고 있어요."
                android:textColor="@color/muted"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:orientation="horizontal">

                <include android:id="@+id/stat1" layout="@layout/item_stat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="26dp" />
                <include android:id="@+id/stat2" layout="@layout/item_stat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="26dp" />
                <include android:id="@+id/stat3" layout="@layout/item_stat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.25" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
