<?xml version="1.0" encoding="utf-8"?>
<!-- ① 펫케어 시작: 두고 내릴 아이를 고르고 시작. 목적지에 도착하면 먼저 뜬다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/part_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingHorizontal="74dp"
        android:paddingTop="56dp"
        android:paddingBottom="64dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="목적지에 도착했어요"
                android:textColor="@color/primary"
                android:textSize="29sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="차에 두고 내리는 아이가 있나요?"
                android:textColor="@color/ink"
                android:textSize="50sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/dogRow"
                android:layout_width="match_parent"
                android:layout_height="449dp"
                android:layout_marginTop="48dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="match_parent"
            android:layout_marginStart="58dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="48dp"
            android:paddingTop="48dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="두고 내리는 아이"
                android:textColor="@color/muted"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/who"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink"
                android:textSize="50sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/check1"
                style="@style/Check"
                android:layout_marginTop="34dp" />

            <TextView
                style="@style/Check"
                android:text="짖으면 조명·음악·목소리로 달래요" />

            <TextView
                style="@style/Check"
                android:text="보호자 폰으로 바로 알려요" />

            <!-- 선택: 기다리는 동안 음악 틀어 두기 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="40dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/musicRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="기다리는 동안 음악 틀기"
                        android:textColor="@color/ink"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="차분한 음악을 작게 계속 틀어 둬요"
                        android:textColor="@color/muted"
                        android:textSize="24sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/musicSwitch"
                    app:thumbTint="@color/sw_thumb"
                    app:trackTint="@color/sw_track"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="1.6"
                    android:scaleY="1.6"
                    android:layout_marginEnd="16dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/trackRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/track1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="18dp"
                    android:text="안정 음악 1"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/track2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="18dp"
                    android:text="안정 음악 2"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="121dp"
                android:background="@drawable/bg_btn_start"
                android:gravity="center"
                android:text="펫케어 시작"
                android:textColor="#FFFFFF"
                android:textSize="45sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:gravity="center"
                android:padding="5dp"
                android:text="아니요, 함께 내려요"
                android:textColor="@color/muted"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
