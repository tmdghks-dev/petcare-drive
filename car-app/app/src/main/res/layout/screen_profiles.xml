<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="72dp"
    android:paddingVertical="56dp">

    <include android:id="@+id/top" layout="@layout/part_top" />

    <TextView
        android:id="@+id/headline"
        style="@style/Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="오늘 함께 타는 아이를 선택하세요" />

    <TextView
        android:id="@+id/sub"
        style="@style/Sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="선택한 아이의 프로필에 맞춰 적정 온도와 진정 방식이 설정돼요" />

    <LinearLayout
        android:id="@+id/dogRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="40dp"
        android:layout_weight="1"
        android:orientation="horizontal" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="32dp">

        <TextView
            android:id="@+id/footnote"
            style="@style/Footnote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnStart"
            style="@style/BtnPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="이 아이와 출발하기" />
    </LinearLayout>
</LinearLayout>
